---
import Navbar from "../../components/Navbar.astro";
import Footer from "../../components/Footer.astro";
import { getCollection } from "astro:content";
import "../../styles/global.css";
import "../../styles/blog.css";

/* 🔥 Static paths */
export async function getStaticPaths() {
  const posts = await getCollection("blog");

  return posts.map(post => ({
    params: { slug: post.slug }
  }));
}

const { slug } = Astro.params;
const posts = await getCollection("blog");

/* Ordenamos por fecha si existe */
const sortedPosts = posts.sort((a, b) => {
  const da = new Date(a.data.date || 0).getTime();
  const db = new Date(b.data.date || 0).getTime();
  return da - db;
});

const postIndex = sortedPosts.findIndex(p => p.slug === slug);
const post = sortedPosts[postIndex];

if (!post) throw new Error("Post no encontrado");

const prevPost = postIndex > 0 ? sortedPosts[postIndex - 1] : null;
const nextPost = postIndex < sortedPosts.length - 1 ? sortedPosts[postIndex + 1] : null;

const { Content } = await post.render();
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{post.data.title} | Luis Antonio</title>

    <style>
      body {
        background: radial-gradient(circle at top center, #0f111a, #08090e);
      }

      header.hero-fixed {
        position: sticky;
        top: 0;
        z-index: 30;
        background: rgba(10,10,15,0.75);
        backdrop-filter: blur(12px);
        border-bottom: 1px solid rgba(0,217,255,0.12);
      }

      @keyframes fadeUp {
        from { opacity: 0; transform: translateY(25px); }
        to { opacity: 1; transform: translateY(0); }
      }

      .fade-up {
        animation: fadeUp 1s ease forwards;
      }

      .post-container {
        max-width: 900px;
        margin: 0 auto;
      }

      .prose {
        max-width: 720px;
        margin: auto;
      }

      .prose img {
        width: 100%;
        max-width: 100%;
        border-radius: 1.5rem;
        margin: 3rem 0;
        object-fit: cover;
        box-shadow:
          0 0 0 1px rgba(0,217,255,.25),
          0 0 40px rgba(0,217,255,.35);
      }

      .prose > p > img {
        max-width: 720px;
        margin-left: auto;
        margin-right: auto;
        display: block;
      }

      /* 🔥 BOTONES CYBER */
      .cyber-btn {
        position: relative;
        padding: 1rem 2.2rem;
        border-radius: 999px;
        font-weight: 700;
        color: #67e8f9;
        background: #0b0f1a;
        border: 1px solid rgba(0,217,255,0.3);
        box-shadow: 0 0 30px #00d9ff33;
        transition: all .4s ease;
        overflow: hidden;
      }

      .cyber-btn:hover {
        box-shadow: 0 0 60px #00d9ffaa;
        transform: scale(1.05);
      }

      .cyber-btn::after {
        content: "";
        position: absolute;
        inset: 0;
        background: rgba(0,217,255,.15);
        filter: blur(25px);
        opacity: 0;
        transition: .4s;
      }

      .cyber-btn:hover::after {
        opacity: 1;
      }

      .nav-grid {
        display: grid;
        grid-template-columns: 1fr auto 1fr;
        gap: 1.5rem;
        margin-top: 5rem;
        align-items: center;
      }
    </style>
  </head>

  <body class="font-sans text-gray-200 min-h-screen flex flex-col">

    <!-- HEADER -->
    <header class="hero-fixed">
      <Navbar />
      <div class="max-w-6xl mx-auto px-6 pt-20 pb-14 text-center fade-up">
        <h1 class="text-5xl md:text-6xl font-extrabold text-white">
          {post.data.title}
        </h1>

        {post.data.description && (
          <p class="mt-4 text-lg text-gray-400 max-w-2xl mx-auto">
            {post.data.description}
          </p>
        )}
      </div>
    </header>

    <!-- CONTENIDO -->
    <main class="flex-grow px-6 pb-32 fade-up">
      <div class="post-container">

        {post.data.cover && (
          <img
            src={post.data.cover}
            alt={post.data.title}
            class="w-full rounded-2xl mb-12 shadow-[0_0_40px_#00d9ff22]"
          />
        )}

        <article class="prose prose-invert prose-cyan">
          <Content />
        </article>

        <!-- NAVEGACIÓN -->
        <div class="nav-grid">

          <div class="flex justify-start">
            {prevPost && (
              <a href={`/blog/${prevPost.slug}`} class="cyber-btn">
                ◀ Entrada anterior
              </a>
            )}
          </div>

          <a href="/blog" class="cyber-btn">
            ← Proyectos e Ideas
          </a>

          <div class="flex justify-end">
            {nextPost && (
              <a href={`/blog/${nextPost.slug}`} class="cyber-btn">
                Entrada siguiente ▶
              </a>
            )}
          </div>

        </div>

      </div>
    </main>

    <Footer />
  </body>
</html>
