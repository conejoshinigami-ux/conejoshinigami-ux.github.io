---
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";

const { title = "Luis Antonio", description = "" } = Astro.props;
---

<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <link rel="stylesheet" href="/styles/global.css" />

  <style>
    /* ============================= */
    /*  FONDO GLOBAL                 */
    /* ============================= */
    body {
      margin: 0;
      min-height: 100vh;
      background: radial-gradient(circle at top center, #0f111a, #08090e);
      color: #e5e7eb;
      font-family: system-ui, sans-serif;
      display: flex;
      flex-direction: column;
    }

    /* ============================= */
    /*  HEADER STICKY                */
    /* ============================= */
    header.hero-fixed {
      position: sticky;
      top: 0;
      z-index: 40;
      background: rgba(10,10,15,0.75);
      backdrop-filter: blur(14px);
      border-bottom: 1px solid rgba(0,217,255,0.15);
      box-shadow: 0 0 25px rgba(0,217,255,0.08);
    }

    /* ============================= */
    /*  CONTENEDOR PRINCIPAL         */
    /* ============================= */
    .site-wrapper {
      flex: 1;
      width: 100%;
      display: flex;
      justify-content: center;
      padding: 4rem 1.5rem 6rem;
    }

    .page {
      width: 100%;
      max-width: 1200px;
      background: rgba(10, 12, 22, 0.75);
      border-radius: 22px;
      border: 1px solid rgba(0,217,255,0.12);
      backdrop-filter: blur(16px);
      box-shadow:
        0 0 0 1px rgba(0,217,255,0.05),
        0 40px 120px rgba(0,0,0,0.85),
        inset 0 0 25px rgba(0,217,255,0.05);
      overflow: hidden;
      display: flex;
      flex-direction: column;
    }

    /* ============================= */
    /*  CONTENIDO                    */
    /* ============================= */
    main {
      flex: 1;
      padding: 3.5rem 3rem 4rem;
    }

    /* ============================= */
    /*  FOOTER                       */
    /* ============================= */
    footer {
      margin-top: auto;
    }

    /* ============================= */
    /*  RESPONSIVE                   */
    /* ============================= */
    @media (max-width: 768px) {
      .site-wrapper {
        padding: 2.5rem 1rem 5rem;
      }

      main {
        padding: 2.2rem 1.6rem 3rem;
      }
    }
  </style>
</head>

<body>

  <!-- HEADER -->
  <header class="hero-fixed">
    <Navbar />
  </header>

  <!-- CONTENIDO -->
  <div class="site-wrapper">
    <div class="page">
      <main>
        <slot />
      </main>
    </div>
  </div>

  <!-- FOOTER -->
  <Footer />

</body>
</html>
